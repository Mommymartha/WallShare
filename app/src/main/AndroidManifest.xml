<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking to Supabase. ACCESS_NETWORK_STATE is intentionally omitted - nothing
         in the current scaffold inspects connectivity state. Add it back only when a
         real feature (e.g. a connectivity-aware retry check) needs it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to actually change the device wallpaper -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Required on Android 13+ if we ever show a "wallpaper updated" notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".WallShareApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.WallShare"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WallShare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receives FCM data messages when Android's background-delivery rules permit it
          (Scenarios 4 & 5 in the normal case). This is NOT a guarantee: a force-stopped
          app, or aggressive OEM battery management, can delay or drop delivery entirely
          until the app is next opened. The backend (Supabase) remains the source of
          truth - a startup/foreground reconciliation check that fetches any still-PENDING
          wallpaper_request is required to cover that gap (planned for a later step, not
          implemented in this scaffold). This service does NOT do the wallpaper work
          itself - it hands off to WorkManager so we never block onMessageReceived and
          always respect background execution limits. See
          notifications/WallShareMessagingService.kt.
        -->
        <service
            android:name=".notifications.WallShareMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
